# --- App ---
APP_NAME=inboxos
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/v1

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth (PKCE) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# Where to send the browser after login succeeds (your frontend)
POST_LOGIN_REDIRECT_URL=http://localhost:3000

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=inboxos_user
POSTGRES_PASSWORD=inboxos_password
POSTGRES_DB=inboxos
# Async driver used by SQLAlchemy / the app
DATABASE_URL=postgresql+asyncpg://inboxos_user:inboxos_password@db:5432/inboxos

# --- RabbitMQ (Celery broker) ---
RABBITMQ_USER=inboxos
RABBITMQ_PASSWORD=inboxos
# Trailing // = the default "/" vhost
CELERY_BROKER_URL=amqp://inboxos:inboxos@rabbitmq:5672//

# --- Redis (Celery result backend + app cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLASSIFIER_MODELS=gpt-4o-mini,gpt-4o

# --- Google (direct Gmail + Calendar access) ---
# One OAuth grant covers both products.
# Uses the same GOOGLE_CLIENT_ID/SECRET as login, so the Cloud console needs:
#   1. Authorised redirect URI: {PUBLIC_BASE_URL}/v1/integrations/google/callback
#   2. Consent screen scopes:   gmail.modify, gmail.settings.basic, calendar
# Both Gmail scopes are RESTRICTED — an unverified app is capped at 100 test
# users, and general availability needs Google verification plus a CASA
# assessment. Note also that while the app is in "Testing" status, refresh
# tokens expire after 7 days, so grants will need redoing in development.
#
# Comma-separated Fernet keys encrypting the stored OAuth tokens. The first
# encrypts, all of them decrypt, so rotating means prepending a new key and
# leaving the old one until the rows have turned over. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank means no user can connect their account.
GOOGLE_TOKEN_ENCRYPTION_KEYS=

# Gmail push. `users.watch` publishes mailbox changes to a Pub/Sub topic which
# pushes to $PUBLIC_BASE_URL/v1/webhooks/gmail — mail lands in seconds instead
# of waiting for the reconciliation sweep. Setup, once, in Google Cloud:
#
#   1. Create a Pub/Sub topic, e.g. projects/<project>/topics/gmail-push
#   2. Grant gmail-api-push@system.gserviceaccount.com the
#      "Pub/Sub Publisher" role ON THAT TOPIC (not on the project)
#   3. Create a PUSH subscription to it, endpoint
#      $PUBLIC_BASE_URL/v1/webhooks/gmail, with an OIDC token from a service
#      account of yours — put that account's address in GOOGLE_PUBSUB_SA_EMAIL
#
# The endpoint must be HTTPS with a certificate from a real CA. Note that a
# watch expires after 7 days; the gmail-watch-renew beat job reinstalls it.
GMAIL_PUSH_ENABLED=false
GOOGLE_PUBSUB_TOPIC=
# Blank disables verification of the push request — anyone who finds the URL
# could then make the app spend Gmail quota. Set it in production.
GOOGLE_PUBSUB_SA_EMAIL=
# Only needed if the push subscription sets an explicit OIDC audience.
GOOGLE_PUBSUB_AUDIENCE=

# The reconciliation sweep, every 15 minutes. With push on this is the safety
# net that catches dropped notifications and lapsed watches. With push OFF it
# becomes the only way mail arrives at all — turn it on either way, and
# consider shortening the interval in beat_schedule.py if you run without push.
GMAIL_POLL_ENABLED=false
# Parallel messages.get calls per fetch. Gmail allows ~300 message fetches per
# user per minute; 5 is a modest fraction of that.
GMAIL_FETCH_CONCURRENCY=5
GOOGLE_HTTP_TIMEOUT=30

# --- Meeting notetaker ---
# Provider that puts a bot in Zoom/Meet/Teams calls. Only "recall" today.
MEETING_BOT_PROVIDER=recall
# Region host must match the region your API key was issued in.
RECALL_API_BASE=https://us-east-1.recall.ai
RECALL_API_KEY=
# Workspace webhook signing secret ("whsec_...") from the Recall dashboard.
# Point the webhook at $PUBLIC_BASE_URL/v1/webhooks/meeting-bot
RECALL_WEBHOOK_SECRET=

# Object storage for recordings we host ourselves — uploaded files and browser
# recordings. Recall keeps its own bot recordings, so this is only needed for
# "Start recording now" and "Upload a recording".
#
# The bucket needs a CORS rule allowing PUT and GET from the web origin: the
# browser uploads straight to it, and a missing rule fails in the browser with
# no server-side trace.
MEDIA_STORAGE_PROVIDER=s3
# Defaults below are the MinIO service in docker-compose — local dev works with
# no bucket to provision and no cloud account.
#   AWS:  leave S3_ENDPOINT_URL blank, set S3_REGION to the bucket's region
#   R2:   https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://minio:9000
# Where the *browser* reaches the bucket, when that differs from the line above.
# A presigned URL is signed against its host, so a URL signed for `minio:9000`
# fails with SignatureDoesNotMatch when opened from the browser at localhost.
# Leave blank for AWS and R2 — there both sides use the same public host.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002
S3_REGION=auto
S3_BUCKET=inboxos-media
S3_ACCESS_KEY_ID=inboxos
S3_SECRET_ACCESS_KEY=inboxos-secret

# Transcription for media no bot attended. Needs OPENAI_API_KEY above, and
# ffmpeg in the image (the Dockerfile installs it).
TRANSCRIBE_MODEL=gpt-4o-transcribe

# =============================================================================
# Public URLs
# =============================================================================
# THE TWO BELOW HAVE DEFAULTS THAT FAIL SILENTLY IN PRODUCTION. Both were
# undocumented here for a while, which is how a deployed build ends up with
# neither set and no error to explain what broke.

# Where *this API* is reachable from. Google's OAuth callback lands here, so it
# must exactly match the authorised redirect URI registered in the Cloud
# console, or connecting an account fails at the last step. Mail itself no
# longer depends on this value — the worker polls Gmail outbound.
PUBLIC_BASE_URL=http://localhost:8000

# Where the web app is. Every public booking link and every "reschedule or
# cancel" link in a confirmation email is built from this. Left at the default,
# guests are emailed links to localhost and have no way back to their booking.
FRONTEND_BASE_URL=http://localhost:3000

# =============================================================================
# Scheduling / Google Calendar
# =============================================================================

# =============================================================================
# Self-emailed slash commands
# =============================================================================
COMMANDS_LOOKBACK=newer_than:2d
COMMANDS_MAX_PER_SWEEP=10

# =============================================================================
# Billing (Razorpay). Checkout fails closed while these are blank.
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_ANNUAL=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
# Free trial length before a subscription is required.
TRIAL_DAYS=7

# =============================================================================
# Models and media tuning (defaults are sane; override only to tune)
# =============================================================================
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o
RECALL_TIMEOUT_SECONDS=30
MEDIA_UPLOAD_MAX_BYTES=1073741824
MEDIA_URL_TTL_SECONDS=3600
MEDIA_LIVE_URL_TTL_SECONDS=21600

# Default time zone for a user who has not set one.
MAILMAN_DEFAULT_TZ=Asia/Kolkata

# Log every SQL statement. Never enable in production.
SQL_ECHO=false
